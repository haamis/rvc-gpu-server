[Unit]
Description=RVC GPU worker server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/rvc-server/env
Environment=RVC_MODEL_ROOT=%h/rvc-gpu-server/rvc_models
Environment=RVC_GPU_SERVER_PORT=8001
# PyTorch's CUDA allocator fragments under RVC's per-shape CUDA-graph
# captures; expandable segments trade a little throughput for far fewer
# spurious OOMs on an 8GB card.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# onnxruntime-gpu (Kokoro) needs cuDNN: reuse the copy bundled with torch's
# pip wheels (no sudo-required system install).
Environment=LD_LIBRARY_PATH=%h/rvc-server-venv/lib/python3.12/site-packages/nvidia/cudnn/lib:%h/rvc-server-venv/lib/python3.12/site-packages/nvidia/cublas/lib:%h/rvc-server-venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib
# Eager inference (no CUDA-graph capture): trades some speed for flat VRAM
# and arbitrarily long inputs. Remove to re-enable graphs.
Environment=RVC_CUDA_GRAPH=0
ExecStart=%h/rvc-server-venv/bin/python %h/rvc-gpu-server/server.py
WorkingDirectory=%h/rvc-gpu-server
Restart=on-failure
RestartSec=10
StandardOutput=append:/tmp/rvc_server.log
StandardError=inherit

[Install]
WantedBy=default.target
